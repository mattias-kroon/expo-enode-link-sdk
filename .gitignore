.DS_Store

# VSCode
.vscode/
jsconfig.json

# Xcode
#
build/
# ...but NOT the root build/ directory: that is the compiled TypeScript that
# package.json points `main` and `types` at. Consumers install this package from
# a git URL rather than npm, and the `prepare` script that would compile it does
# not reliably run for git dependencies (nor on EAS), so the output is committed.
# Regenerate with `yarn build` after changing anything under src/.
!/build/
*.pbxuser
!default.pbxuser
*.mode1v3
!default.mode1v3
*.mode2v3
!default.mode2v3
*.perspectivev3
!default.perspectivev3
xcuserdata
*.xccheckout
*.moved-aside
DerivedData
*.hmap
*.ipa
*.xcuserstate
project.xcworkspace

# Android/IJ
#
.classpath
.cxx
.gradle
.idea
.project
.settings
local.properties
android.iml
android/app/libs
android/keystores/debug.keystore

# Cocoapods
#
example/ios/Pods

# Ruby
example/vendor/

